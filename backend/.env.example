# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# App
APP_ENV=development
APP_DEBUG=true
APP_NAME="Tram API"
APP_VERSION="0.1.0"
CORS_ORIGINS=http://localhost:3000

# Binance
# Use Binance Vision (official public mirror, port 443, usually NOT blocked by ISPs/campus Wi-Fi)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_REST_BASE_URL=https://data-api.binance.vision/api/v3
BINANCE_WS_BASE_URL=wss://data-stream.binance.vision/stream

# Alternative: Direct Binance (may be blocked in some regions)
# BINANCE_REST_BASE_URL=https://api.binance.com/api/v3
# BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/stream

# Optional: HTTP/SOCKS5 Proxy (e.g. Clash, v2ray, Shadowsocks) if Binance is blocked
# BINANCE_PROXY_URL=http://127.0.0.1:7890
BINANCE_PROXY_URL=

# Telegram (get from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
