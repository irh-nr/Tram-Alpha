# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# App
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Endpoints (Default is direct to Binance).
# If Binance is blocked on your network (e.g. eduroam/campus Wi-Fi or ISP block):
# Option A: Binance Vision (official public mirror, port 443, usually NOT blocked):
#   BINANCE_REST_BASE_URL=https://data-api.binance.vision/api/v3
#   BINANCE_WS_BASE_URL=wss://data-stream.binance.vision/stream
# Option B: Cloudflare Worker Reverse Proxy (see cloudflare-worker/):
#   BINANCE_REST_BASE_URL=https://your-worker.workers.dev/api/v3
#   BINANCE_WS_BASE_URL=wss://your-worker.workers.dev/stream
# Option C: Local / HTTP / SOCKS5 Proxy (e.g. Clash, v2ray, Shadowsocks):
#   BINANCE_PROXY_URL=http://127.0.0.1:7890
BINANCE_REST_BASE_URL=https://api.binance.com/api/v3
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/stream
BINANCE_PROXY_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
